# ====================================================================
# OS Specific
# ====================================================================
.DS_Store
Thumbs.db
*.swp
*~

# ====================================================================
# IDEs (IntelliJ, Android Studio, VS Code)
# ====================================================================
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# ====================================================================
# Kotlin / Gradle (Server Manager & Android)
# ====================================================================
.gradle/
build/
/out/
capture/
local.properties
.ksc/

# Gradle Wrapper (Optional: usually kept, but ignored if you want users to use local gradle)
#!gradle-wrapper.jar

# ====================================================================
# C++ / Native (PPNNI.Mock & Android JNI)
# ====================================================================
# Ignore all build directories
**/build/
**/bin/
**/obj/
**/libs/

# Ignore auto-downloaded testing frameworks (Prevents version conflicts)
tests/catch.hpp

# Ignore compiled binaries/libraries
*.exe
*.o
*.out
*.so
*.dylib
*.a
*.dll

# Android NDK / CMake specific
.cxx/
externalNativeBuild/
.externalNativeBuild/

# ====================================================================
# PPNNI Mock Specific
# ====================================================================
# Ignore temporary test files generated by the Unit Test suite
unit_test_temp.inp
mock_echo.sh

# ====================================================================
# Misc / Logs
# ====================================================================
*.log
*.tmp
*.bak