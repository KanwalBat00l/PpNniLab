{
  "openapi": "3.0.3",
  "info": {
    "title": "Server Manager API",
    "version": "1.0",
    "description": "Manage AI servers (start, check status)"
  },
  "paths": {
    "/getServer": {
      "get": {
        "summary": "Start a server",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "sqnet",
                "sqnet_quantized",
                "resnet50",
                "resnet50_quantized"
              ]
            }
          },
          {
            "name": "protocol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "cheetah",
                "SCI_HE"
              ]
            }
          }
        ],
        "responses": { "200": { "description": "Server started" } }
      }
    },
    "/status": {
      "get": {
        "summary": "Get running servers",
        "responses": { "200": { "description": "Server statuses" } }
      }
    }
  }
}
