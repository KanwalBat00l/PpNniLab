<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Server URL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_url"
            android:contentDescription="Server URL Icon"
            android:paddingEnd="8dp"/>


        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Server URL"
            android:text="http://10.0.2.2:8080"
            android:textSize="22sp"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Neural Network Model -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_model"
            android:contentDescription="Model Icon"
            android:paddingEnd="8dp"/>

        <Spinner
            android:id="@+id/spModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="28sp"
            android:entries="@array/models"/>
    </LinearLayout>

    <!-- Security Protocol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_protocol"
            android:contentDescription="Protocol Icon"
            android:paddingEnd="8dp"/>

        <Spinner
            android:id="@+id/spProtocol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="28sp"
            android:entries="@array/protocols"/>
    </LinearLayout>

    <!-- Connect Button -->
    <Button
        android:id="@+id/btnConnectServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Server"
        android:textSize="20sp"
        android:padding="16dp"
        android:backgroundTint="@color/purple_500"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"/>

    <!-- Select Image Button -->
    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Image"
        android:textSize="20sp"
        android:padding="16dp"
        android:backgroundTint="@color/teal_200"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:alpha="0.4"/>


    <!-- Scrollable Result Area -->
    <ScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/gray_light"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp"
            android:scrollbars="vertical"/>
    </ScrollView>

</LinearLayout>
