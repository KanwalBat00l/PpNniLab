{
  "openapi": "3.0.3",
  "info": {
    "title": "PPNNI Server Manager API",
    "version": "1.0",
    "description": "Dynamic Orchestration for Privacy Preserving Inference"
  },
  "paths": {
    "/getServer": {
      "get": {
        "summary": "Start a mock inference server",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["resnet50", "resnet50_quantized", "sqnet", "sqnet_quantized"]
            }
          },
          {
            "name": "protocol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["cheetah", "SCI_HE"]
            }
          }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/status": {
      "get": {
        "summary": "Get all active server instances",
        "responses": { "200": { "description": "Success" } }
      }
    }
  }
}